# Copy to .env (never commit .env). Real secrets later go to Azure Key Vault.
GRIDPULSE_DATA_DIR=./data
# Free token: register at transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "Restful API access" to request a token.
ENTSOE_API_KEY=
# Weather stations (Bright Sky takes lat/lon); defaults cover major German regions.
GRIDPULSE_LOG_LEVEL=INFO

# Storage backend: "local" (default) or "adls" (Azure Data Lake Gen2, auth via az login / managed identity)
GRIDPULSE_STORAGE_BACKEND=local
# GRIDPULSE_ADLS_ACCOUNT_URL=https://<storage_account_name>.dfs.core.windows.net
# GRIDPULSE_ADLS_FILESYSTEM=bronze
