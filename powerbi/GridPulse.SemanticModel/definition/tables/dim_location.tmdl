table dim_location
	column location_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: location_key

	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location

	column latitude
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: longitude

	column region_type
		dataType: string
		summarizeBy: none
		sourceColumn: region_type

	partition dim_location = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Data = Source{[Schema="gold", Item="dim_location"]}[Data]
				in
					Data
