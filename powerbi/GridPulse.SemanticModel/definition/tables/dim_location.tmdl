table dim_location
	column location_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: location_key

	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location

	column latitude
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: longitude

	column region_type
		dataType: string
		summarizeBy: none
		sourceColumn: region_type

	partition dim_location = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents(CsvFolder & "dim_location.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"location_key", Int64.Type}, {"location", type text}, {"latitude", type number}, {"longitude", type number}, {"region_type", type text}}, "en-US")
				in
					Typed
