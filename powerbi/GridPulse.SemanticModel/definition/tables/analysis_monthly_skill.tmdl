table analysis_monthly_skill
	column month
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column mae_naive
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: mae_naive

	column mae_model
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: mae_model

	column diff
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: diff

	column diff_low
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: diff_low

	column diff_high
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: diff_high

	partition analysis_monthly_skill = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents(CsvFolder & "analysis_monthly_skill.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"month", type text}, {"mae_naive", type number}, {"mae_model", type number}, {"diff", type number}, {"diff_low", type number}, {"diff_high", type number}}, "en-US")
				in
					Typed
