table analysis_noise
	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column noise_pct
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: noise_pct

	column mae
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: mae

	column gain
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: gain

	column gain_low
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: gain_low

	column gain_high
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: gain_high

	partition analysis_noise = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents(CsvFolder & "analysis_noise.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"label", type text}, {"noise_pct", type number}, {"mae", type number}, {"gain", type number}, {"gain_low", type number}, {"gain_high", type number}}, "en-US")
				in
					Typed
