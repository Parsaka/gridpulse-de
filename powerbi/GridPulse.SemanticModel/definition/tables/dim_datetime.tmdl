table dim_datetime
	column ts_utc
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		summarizeBy: none
		sourceColumn: ts_utc

	column ts_local
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		summarizeBy: none
		sourceColumn: ts_local

	column date_local
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: date_local

	column hour_local
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: hour_local

	column iso_weekday
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: iso_weekday

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column month_local
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month_local

	column year_local
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year_local

	partition dim_datetime = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents(CsvFolder & "dim_datetime.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"ts_utc", type datetime}, {"ts_local", type datetime}, {"date_local", type datetime}, {"hour_local", Int64.Type}, {"iso_weekday", Int64.Type}, {"is_weekend", type logical}, {"month_local", Int64.Type}, {"year_local", Int64.Type}}, "en-US")
				in
					Typed
