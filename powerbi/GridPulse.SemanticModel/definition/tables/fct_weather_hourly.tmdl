table fct_weather_hourly
	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location

	column ts_utc
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		summarizeBy: none
		sourceColumn: ts_utc

	column temperature_c
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: temperature_c

	column wind_speed_kmh
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: wind_speed_kmh

	column wind_direction_deg
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: wind_direction_deg

	column cloud_cover_pct
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: cloud_cover_pct

	column sunshine_min
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: sunshine_min

	column solar_kwh_m2
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: solar_kwh_m2

	column precipitation_mm
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: precipitation_mm

	column pressure_hpa
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: pressure_hpa

	/// Mean temperature in degrees Celsius over the selected stations and hours.
	measure 'Avg Temperature C' = AVERAGE(fct_weather_hourly[temperature_c])
		formatString: 0.0

	/// Mean wind speed in km/h over the selected stations and hours.
	measure 'Avg Wind Speed kmh' = AVERAGE(fct_weather_hourly[wind_speed_kmh])
		formatString: 0.0

	partition fct_weather_hourly = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents(CsvFolder & "fct_weather_hourly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"location", type text}, {"ts_utc", type datetime}, {"temperature_c", type number}, {"wind_speed_kmh", type number}, {"wind_direction_deg", type number}, {"cloud_cover_pct", type number}, {"sunshine_min", type number}, {"solar_kwh_m2", type number}, {"precipitation_mm", type number}, {"pressure_hpa", type number}}, "en-US")
				in
					Typed
