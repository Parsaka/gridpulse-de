table fct_weather_hourly
	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location

	column ts_utc
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		summarizeBy: none
		sourceColumn: ts_utc

	column temperature_c
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: temperature_c

	column wind_speed_kmh
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: wind_speed_kmh

	column wind_direction_deg
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: wind_direction_deg

	column cloud_cover_pct
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: cloud_cover_pct

	column sunshine_min
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: sunshine_min

	column solar_kwh_m2
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: solar_kwh_m2

	column precipitation_mm
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: precipitation_mm

	column pressure_hpa
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: pressure_hpa

	measure 'Avg Temperature C' = AVERAGE(fct_weather_hourly[temperature_c])
		formatString: 0.0
		description: Mean temperature in degrees Celsius over the selected stations and hours.

	measure 'Avg Wind Speed kmh' = AVERAGE(fct_weather_hourly[wind_speed_kmh])
		formatString: 0.0
		description: Mean wind speed in km/h over the selected stations and hours.

	partition fct_weather_hourly = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Data = Source{[Schema="gold", Item="fct_weather_hourly"]}[Data],
					Utc = Table.TransformColumns(Data, {{"ts_utc", each DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_, 0)), type datetime}})
				in
					Utc
