{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "line_price",
  "position": {
    "x": 24,
    "y": 120,
    "z": 0,
    "width": 820,
    "height": 290
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_datetime"
                    }
                  },
                  "Property": "date_local"
                }
              },
              "queryRef": "dim_datetime.date_local",
              "nativeQueryRef": "date_local"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_market_hourly"
                    }
                  },
                  "Property": "Avg Price"
                }
              },
              "queryRef": "fct_market_hourly.Avg Price",
              "nativeQueryRef": "Avg Price"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Daily average price'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
