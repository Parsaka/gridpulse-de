{
  "title": "GridPulse API health",
  "uid": "gridpulse-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Warehouse up", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "gridpulse_db_up", "refId": "A"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"id": 2, "type": "stat", "title": "Data freshness (h)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "gridpulse_data_freshness_hours", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "h", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 24}, {"color": "red", "value": 36}]}}}},
    {"id": 3, "type": "stat", "title": "Model age (h)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "gridpulse_model_age_hours", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "h", "decimals": 1}}},
    {"id": 4, "type": "stat", "title": "Forecasts served", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "gridpulse_forecasts_total", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Requests / s by status", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (status) (rate(gridpulse_api_requests_total{path!=\"/metrics\"}[1m]))", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Latency p50 / p95 (s)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(gridpulse_api_request_seconds_bucket{path!=\"/metrics\"}[1m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(gridpulse_api_request_seconds_bucket{path!=\"/metrics\"}[1m])))", "legendFormat": "p95", "refId": "B"}]}
  ]
}
